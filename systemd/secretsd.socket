[Unit]
Description=secretsd session secrets broker socket

[Socket]
ListenStream=%t/secretsd.sock
# Load-bearing: the broker socket is private to its owning Unix user.
SocketMode=0600
# Load-bearing: systemd hands one shared listening socket to the daemon.
Accept=no
# Load-bearing: discard the runtime socket when the unit stops; never leave a stale endpoint.
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
