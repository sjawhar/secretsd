[Unit]
Description=secretsd session secrets broker
Requires=secretsd.socket
After=secretsd.socket

[Service]
Type=simple
# The release installer places the daemon here. `%h` expands before execution,
# yielding an absolute path; `Environment=PATH` never resolves `ExecStart`.
ExecStart=%h/.local/bin/secrets serve
# This PATH is inherited only by daemon children. Deployment drop-ins must add
# the absolute directory containing the real age-plugin-yubikey executable.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# Required deployment configuration. A consumer-owned drop-in must replace the
# empty value with an absolute secret directory; otherwise the daemon fails
# loudly at startup rather than selecting a fallback directory.
Environment=SECRETSD_HUMAN_DIR=
# Load-bearing: secretsd calls mlockall and refuses to start without unlimited
# locked memory, keeping plaintext out of swap.
LimitMEMLOCK=infinity
# SECRETSD_MEMLOCK defaults to require. Do not set it to optional in production:
# optional permits startup without locked memory, so plaintext pages may swap.
# Load-bearing: core dumps could persist plaintext, so they must stay disabled.
LimitCORE=0
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
