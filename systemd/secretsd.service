[Unit]
Description=secretsd session secrets broker
Requires=secretsd.socket
After=secretsd.socket

[Service]
Type=simple
# The release installs secretsd here; deployments override PATH only in their
# consumer-owned drop-in when their real helper binaries live elsewhere.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=secretsd
# Load-bearing: secretsd calls mlockall and refuses to start without unlimited
# locked memory, keeping plaintext out of swap.
LimitMEMLOCK=infinity
# SECRETSD_MEMLOCK defaults to require. Do not set it to optional in production:
# optional permits startup without locked memory, so plaintext pages may swap.
# Load-bearing: core dumps could persist plaintext, so they must stay disabled.
LimitCORE=0
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
