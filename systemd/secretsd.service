[Unit]
Description=secretsd session secrets broker
Requires=secretsd.socket
After=secretsd.socket

[Service]
Type=simple
ExecStart=%h/.dotfiles/bin/secretsd
Environment=SECRETSD_HUMAN_DIR=%h/.dotfiles/secrets.human.d
# Announcement channels. At least one must acknowledge before the daemon will
# start a decrypt, so configuring only one makes a single missing binary fail
# every grant closed. The desktop channel needs libnotify-bin and a session bus
# (laptop only); the envoy channel works headlessly and is the devbox path.
Environment="SECRETSD_NOTIFY_CMD=notify-send --app-name=secretsd --urgency=critical secretsd"
Environment="SECRETSD_ENVOY_CMD=%h/.dotfiles/scripts/envoy send notifications.secrets.request"
# Locking pages is mandatory in production; without this the daemon refuses to start.
LimitMEMLOCK=infinity
LimitCORE=0
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
